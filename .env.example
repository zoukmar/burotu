# Copier en .env pour le développement local. Ne jamais commiter .env.

# Meta Model API (Muse Spark). Sans clé, Burotu tourne en mode mock.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Site et suivi
BUROTU_ADMIN_USER=admin
BUROTU_ADMIN_PASSWORD=dev
BUROTU_SECRET_KEY=change-me
BUROTU_PUBLIC_HOSTS=localhost,127.0.0.1
BUROTU_ADMIN_HOST=admin.localhost
BUROTU_DB_PATH=data/site.db
